import React, { useState } from "react";
import { CLUBS, formatCurrency, formatPercent, formatRatio, computeMetrics } from "@/lib/terminalData";

const METRICS = [
  { key: "revenue", label: "Revenue", format: (v, cur) => formatCurrency(v, cur, true), higher: true },
  { key: "wages", label: "Wage Bill", format: (v, cur) => formatCurrency(v, cur, true), higher: false },
  { key: "wageRatio", label: "Wage Ratio", format: (v) => formatPercent(v), higher: false },
  { key: "profitLoss", label: "Profit / Loss", format: (v, cur) => formatCurrency(v, cur, true), higher: true },
  { key: "netDebt", label: "Net Debt", format: (v, cur) => formatCurrency(v, cur, true), higher: false },
  { key: "netAssets", label: "Net Assets", format: (v, cur) => formatCurrency(v, cur, true), higher: true },
  { key: "marketValue", label: "Squad Market Value", format: (v, cur) => formatCurrency(v, cur, true), higher: true },
  { key: "squadEfficiency", label: "Squad Efficiency", format: (v) => formatRatio(v), higher: true },
  { key: "enterpriseValue", label: "Enterprise Value", format: (v, cur) => formatCurrency(v, cur, true), higher: true },
];

const COMPUTED_METRICS = [
  { key: "ltv", label: "Loan-to-Value", format: (v) => formatPercent(v), higher: false },
  { key: "evRev", label: "EV / Revenue", format: (v) => formatRatio(v) + "x", higher: true },
  { key: "icr", label: "Interest Coverage", format: (v) => v > 100 ? "N/A" : formatRatio(v) + "x", higher: true },
  { key: "liquidityBuffer", label: "Liquidity Buffer", format: (v) => v > 100 ? "N/A" : formatRatio(v) + "x", higher: true },
  { key: "commercialDebtExposure", label: "Comm. Debt Exposure", format: (v) => formatPercent(v), higher: false },
];

function rankValues(clubs, key, computed, currency) {
  const values = clubs.map((club) => {
    const val = computed
      ? computeMetrics(club, currency)[key]
      : club.current[key];
    return { id: club.id, val };
  });
  const sorted = [...values].sort((a, b) => b.val - a.val);
  const ranks = {};
  values.forEach(({ id, val }) => {
    ranks[id] = sorted.findIndex((s) => s.id === id) + 1;
  });
  return { ranks, values };
}

function getRankColor(rank, total, higher) {
  const pct = higher ? (rank - 1) / (total - 1) : (total - rank) / (total - 1);
  if (pct <= 0.25) return "text-[#ffffff]";
  if (pct <= 0.5) return "text-[#cccccc]";
  if (pct <= 0.75) return "text-yellow-400";
  return "text-[#ff4d4d]";
}

export default function TabComparison({ currency }) {
  const [sort, setSort] = useState({ key: "revenue", computed: false, dir: -1 });

  const sorted = [...CLUBS].sort((a, b) => {
    const av = sort.computed ? computeMetrics(a, currency)[sort.key] : a.current[sort.key];
    const bv = sort.computed ? computeMetrics(b, currency)[sort.key] : b.current[sort.key];
    return sort.dir * (bv - av);
  });

  const handleSort = (key, computed) => {
    setSort((prev) =>
      prev.key === key ? { key, computed, dir: prev.dir * -1 } : { key, computed, dir: -1 }
    );
  };

  const total = CLUBS.length;

  return (
    <div className="space-y-4">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h3 className="font-heading text-sm font-semibold text-[#ffffff]">League-Wide Comparative Rankings</h3>
          <p className="font-mono text-[10px] text-[#808080] mt-0.5">Click any column header to sort · Color = rank position</p>
        </div>
        <div className="hidden sm:flex gap-3 font-mono text-[10px]">
          <span className="text-[#ffffff]">● Top quartile</span>
          <span className="text-yellow-400">● Bottom half</span>
          <span className="text-[#ff4d4d]">● Bottom quartile</span>
        </div>
      </div>

      {/* Core Metrics Table */}
      <div className="bg-[#161616] border border-[#2a2a2a] rounded-md overflow-hidden">
        <div className="px-4 py-2.5 border-b border-[#2a2a2a] bg-[#0d0d0d]/50">
          <h4 className="font-mono text-[10px] text-[#808080] uppercase tracking-wider">Core Financial Metrics</h4>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead>
              <tr className="border-b border-[#2a2a2a]">
                <th className="font-mono text-[10px] text-[#808080] text-left py-2 px-3 uppercase sticky left-0 bg-[#161616] z-10 min-w-[140px]">Club</th>
                {METRICS.map((m) => (
                  <th
                    key={m.key}
                    onClick={() => handleSort(m.key, false)}
                    className={`font-mono text-[10px] text-right py-2 px-3 uppercase cursor-pointer select-none whitespace-nowrap transition-colors ${
                      sort.key === m.key && !sort.computed ? "text-[#ffffff]" : "text-[#808080] hover:text-[#ffffff]"
                    }`}
                  >
                    {m.label} {sort.key === m.key && !sort.computed ? (sort.dir === -1 ? "↓" : "↑") : ""}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {sorted.map((club) => (
                <tr key={club.id} className="border-b border-[#2a2a2a]/30 hover:bg-[#1a1a1a]/60 transition-colors">
                  <td className="py-2 px-3 sticky left-0 bg-[#161616] z-10">
                    <div>
                      <p className="font-mono text-[11px] text-[#ffffff] font-semibold whitespace-nowrap">{club.name}</p>
                      <p className="font-mono text-[9px] text-[#808080]">{club.league}</p>
                    </div>
                  </td>
                  {METRICS.map((m) => {
                    const val = club.current[m.key];
                    const { ranks } = rankValues(CLUBS, m.key, false, currency);
                    const color = getRankColor(ranks[club.id], total, m.higher);
                    return (
                      <td key={m.key} className={`font-mono text-[11px] text-right py-2 px-3 ${color}`}>
                        {m.format(val, currency)}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* Computed / Ratio Metrics Table */}
      <div className="bg-[#161616] border border-[#2a2a2a] rounded-md overflow-hidden">
        <div className="px-4 py-2.5 border-b border-[#2a2a2a] bg-[#0d0d0d]/50">
          <h4 className="font-mono text-[10px] text-[#808080] uppercase tracking-wider">Derived Ratios & Solvency</h4>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead>
              <tr className="border-b border-[#2a2a2a]">
                <th className="font-mono text-[10px] text-[#808080] text-left py-2 px-3 uppercase sticky left-0 bg-[#161616] z-10 min-w-[140px]">Club</th>
                {COMPUTED_METRICS.map((m) => (
                  <th
                    key={m.key}
                    onClick={() => handleSort(m.key, true)}
                    className={`font-mono text-[10px] text-right py-2 px-3 uppercase cursor-pointer select-none whitespace-nowrap transition-colors ${
                      sort.key === m.key && sort.computed ? "text-[#ffffff]" : "text-[#808080] hover:text-[#ffffff]"
                    }`}
                  >
                    {m.label} {sort.key === m.key && sort.computed ? (sort.dir === -1 ? "↓" : "↑") : ""}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {sorted.map((club) => {
                const cm = computeMetrics(club, currency);
                return (
                  <tr key={club.id} className="border-b border-[#2a2a2a]/30 hover:bg-[#1a1a1a]/60 transition-colors">
                    <td className="py-2 px-3 sticky left-0 bg-[#161616] z-10">
                      <p className="font-mono text-[11px] text-[#ffffff] font-semibold whitespace-nowrap">{club.name}</p>
                    </td>
                    {COMPUTED_METRICS.map((m) => {
                      const val = cm[m.key];
                      const { ranks } = rankValues(CLUBS, m.key, true, currency);
                      const color = getRankColor(ranks[club.id], total, m.higher);
                      return (
                        <td key={m.key} className={`font-mono text-[11px] text-right py-2 px-3 ${color}`}>
                          {m.format(val, currency)}
                        </td>
                      );
                    })}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

