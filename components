                {isVisible && (
                  <svg className="w-2 h-2 text-[#0d0d0d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={4}>
                    <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </div>
              <span className="w-2 h-2 rounded-full" style={{ backgroundColor: s.color }} />
              {s.label}
            </button>
          );
        })}
      </div>

      <SectionCard title={`${club.name} — 5-Year Longitudinal Series (${symbol} millions)`}>
        <div className="h-[350px] md:h-[420px]">
          <ResponsiveContainer width="100%" height="100%">
            <LineChart data={chartData} margin={{ top: 10, right: 10, left: 10, bottom: 10 }}>
              <CartesianGrid strokeDasharray="3 3" stroke="#2a2a2a" />
              <XAxis
                dataKey="year"
                stroke="#808080"
                tick={{ fill: "#808080", fontSize: 11, fontFamily: "JetBrains Mono" }}
              />
              <YAxis
                stroke="#808080"
                tick={{ fill: "#808080", fontSize: 10, fontFamily: "JetBrains Mono" }}
                tickFormatter={formatTick}
              />
              <Tooltip
                contentStyle={{
                  backgroundColor: "#161616",
                  border: "1px solid #2a2a2a",
                  borderRadius: "4px",
                  fontFamily: "JetBrains Mono",
                  fontSize: "11px",
                }}
                labelStyle={{ color: "#ffffff" }}
                formatter={(value, name) => [`${symbol}${value}m`, name]}
              />
              <Legend wrapperStyle={{ fontFamily: "JetBrains Mono", fontSize: "10px" }} />
              {SERIES.filter((s) => visible.includes(s.key)).map((s) => (
                <Line
                  key={s.key}
                  type="monotone"
                  dataKey={s.key}
                  stroke={s.color}
                  strokeWidth={2}
                  strokeDasharray={s.dashed ? "5 5" : undefined}
                  dot={{ fill: s.color, r: 3 }}
                  activeDot={{ r: 5 }}
                />
              ))}
            </LineChart>
          </ResponsiveContainer>
        </div>
      </SectionCard>

      {/* Historical data table */}
      <SectionCard title="Historical Data Grid">
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead>
              <tr className="border-b border-[#2a2a2a]">
                <th className="font-mono text-[10px] text-[#808080] text-left py-2 px-2 uppercase">Year</th>
                <th className="font-mono text-[10px] text-[#808080] text-right py-2 px-2 uppercase">Revenue</th>
                <th className="font-mono text-[10px] text-[#808080] text-right py-2 px-2 uppercase">Wages</th>
                <th className="font-mono text-[10px] text-[#808080] text-right py-2 px-2 uppercase">Net Debt</th>
                <th className="font-mono text-[10px] text-[#808080] text-right py-2 px-2 uppercase">P/L</th>
                <th className="font-mono text-[10px] text-[#808080] text-right py-2 px-2 uppercase">MV</th>
                <th className="font-mono text-[10px] text-[#808080] text-right py-2 px-2 uppercase">Eff.</th>
              </tr>
            </thead>
            <tbody>
              {club.historical.map((h) => (
                <tr key={h.year} className="border-b border-[#2a2a2a]/30 hover:bg-[#1a1a1a]/50">
                  <td className="font-mono text-[11px] text-[#ffffff] py-1.5 px-2">{h.year}</td>
                  <td className="font-mono text-[11px] text-[#ffffff] text-right py-1.5 px-2">{symbol}{(h.revenue * multiplier / 1e6).toFixed(1)}m</td>
                  <td className="font-mono text-[11px] text-[#ff4d4d] text-right py-1.5 px-2">{symbol}{(h.wages * multiplier / 1e6).toFixed(1)}m</td>
                  <td className="font-mono text-[11px] text-[#e0a800] text-right py-1.5 px-2">{symbol}{(h.netDebt * multiplier / 1e6).toFixed(1)}m</td>
                  <td className={`font-mono text-[11px] text-right py-1.5 px-2 ${h.profitLoss >= 0 ? "text-[#ffffff]" : "text-[#ff4d4d]"}`}>
                    {symbol}{(h.profitLoss * multiplier / 1e6).toFixed(1)}m
                  </td>
                  <td className="font-mono text-[11px] text-[#999999] text-right py-1.5 px-2">{symbol}{(h.marketValue * multiplier / 1e6).toFixed(1)}m</td>
                  <td className="font-mono text-[11px] text-[#808080] text-right py-1.5 px-2">{h.efficiency.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </SectionCard>
    </div>
  );
}

import React from "react";
import SectionCard from "./SectionCard";
import DataRow from "./DataRow";
import { formatCurrency, formatRatio, formatPercent, computeMetrics } from "@/lib/terminalData";

export default function TabTrading({ club, currency }) {
  const m = computeMetrics(club, currency);
  const c = club.current;

  return (
    <div className="space-y-4">
      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div className="bg-[#1a1a1a] border border-[#2a2a2a] rounded p-3">
          <p className="font-mono text-[10px] text-[#808080] uppercase mb-1">EV / Revenue</p>
          <p className={`font-mono text-base font-bold ${m.evRev >= 0 ? "text-[#ffffff]" : "text-[#ff4d4d]"}`}>{formatRatio(m.evRev)}x</p>
        </div>
        <div className="bg-[#1a1a1a] border border-[#2a2a2a] rounded p-3">
          <p className="font-mono text-[10px] text-[#808080] uppercase mb-1">EV / EBITDA</p>
          <p className={`font-mono text-base font-bold ${m.evEbitda >= 0 ? "text-[#ffffff]" : "text-[#ff4d4d]"}`}>{formatRatio(m.evEbitda)}x</p>
        </div>
        <div className="bg-[#1a1a1a] border border-[#2a2a2a] rounded p-3">
          <p className="font-mono text-[10px] text-[#808080] uppercase mb-1">Loan-to-Value</p>
          <p className={`font-mono text-base font-bold ${m.ltv > 1 ? "text-[#ff4d4d]" : "text-[#ffffff]"}`}>{formatPercent(m.ltv)}</p>
        </div>
        <div className="bg-[#1a1a1a] border border-[#2a2a2a] rounded p-3">
          <p className="font-mono text-[10px] text-[#808080] uppercase mb-1">Interest Coverage</p>
          <p className={`font-mono text-base font-bold ${m.icr < 1.5 ? "text-[#ff4d4d]" : m.icr < 3 ? "text-yellow-400" : "text-[#ffffff]"}`}>
            {m.icr > 100 ? "N/A" : formatRatio(m.icr) + "x"}
          </p>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {/* Valuation Ratios */}
        <SectionCard title="Valuation Ratios">
          <DataRow label="EV / Revenue" value={formatRatio(m.evRev) + "x"} highlight={m.evRev > 0} danger={m.evRev < 0} />
          <DataRow label="EV / EBITDA (est.)" value={formatRatio(m.evEbitda) + "x"} />
          <DataRow label="Net Debt / Revenue" value={formatRatio(m.netDebtRev) + "x"} danger={m.netDebtRev > 2} />
          <DataRow label="Revenue" value={formatCurrency(c.revenue, currency, true)} />
          <DataRow label="EBITDA (est.)" value={formatCurrency(m.ebitda, currency, true)} highlight={m.ebitda > 0} danger={m.ebitda < 0} />
        </SectionCard>

        {/* Asset-Backed Solvency */}
        <SectionCard title="Asset-Backed Solvency">
          <DataRow label="Loan-to-Value (LTV)" value={formatPercent(m.ltv)} danger={m.ltv > 0.8} highlight={m.ltv < 0.5} />
          <DataRow label="Acid Test Ratio" value={formatRatio(m.acidTest > 100 ? 0 : m.acidTest)} highlight={m.acidTest > 1} danger={m.acidTest < 0.8} />
          <DataRow label="Trading Velocity Index" value={formatRatio(m.tradingVelocity)} />
          <DataRow label="True Adjusted Debt" value={formatCurrency(m.trueAdjustedDebt, currency, true)} danger />
          <DataRow label="Roster Collateral Value" value={formatCurrency(c.marketValue, currency, true)} highlight />
        </SectionCard>

        {/* Credit Coverage */}
        <SectionCard title="Credit Coverage Metrics">
          <DataRow
            label="Interest Coverage (ICR)"
            value={m.icr > 100 ? "N/A (no debt)" : formatRatio(m.icr) + "x"}
            highlight={m.icr > 3}
            danger={m.icr < 1.5 && m.icr < 100}
          />
          <DataRow
            label="Debt Service Coverage (DSCR)"
            value={m.dscr > 100 ? "N/A (no debt)" : formatRatio(m.dscr) + "x"}
            highlight={m.dscr > 1.5}
            danger={m.dscr < 1 && m.dscr < 100}
          />
          <DataRow label="UEFA Squad Cost Ratio" value={formatPercent(m.uefaSquadCost)} danger={m.uefaSquadCost > 0.7} highlight={m.uefaSquadCost < 0.6} />
          <DataRow label="Wage-to-Revenue" value={formatPercent(c.wageRatio)} danger={c.wageRatio > 1} />
        </SectionCard>
      </div>
    </div>
  );
}

import React from "react";
import SectionCard from "./SectionCard";
import DataRow from "./DataRow";
import MetricCard from "./MetricCard";
import { formatCurrency, formatRatio, formatPercent, computeMetrics } from "@/lib/terminalData";

export default function TabValuation({ club, currency }) {
  const m = computeMetrics(club, currency);
  const c = club.current;

  return (
    <div className="space-y-4">
      {/* Top KPI Strip */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
        <MetricCard
          label="Enterprise Value"
          value={formatCurrency(m.ev, currency, true)}
          positive={m.ev > 0}
          negative={m.ev < 0}
          large
        />
        <MetricCard
          label="Equity Value"
          value={formatCurrency(m.equityValue, currency, true)}
          positive={m.equityValue > 0}
          negative={m.equityValue < 0}
          large
        />
        <MetricCard
          label="Squad MV"
          value={formatCurrency(c.marketValue, currency, true)}
          positive
        />
        <MetricCard
          label="EV/Revenue"
          value={formatRatio(m.evRev) + "x"}
          positive={m.evRev > 0}
          negative={m.evRev < 0}
        />
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        {/* Base Weight Matrix */}
        <SectionCard title="Base Weight Matrix — Turnover vs Net Assets">
          <DataRow label="Revenue" value={formatCurrency(c.revenue, currency)} highlight />
          <DataRow label="Net Assets" value={formatCurrency(c.netAssets, currency)} highlight={c.netAssets > 0} danger={c.netAssets < 0} />
          <DataRow label="Revenue + Net Assets" value={formatCurrency(c.revenue + c.netAssets, currency)} />
          <DataRow label="Net Profit / Loss" value={formatCurrency(c.profitLoss, currency)} highlight={c.profitLoss > 0} danger={c.profitLoss < 0} />
          <DataRow label="Profitability Factor (1 + P/L÷Rev)" value={formatRatio(1 + (c.profitLoss / c.revenue))} />
          <DataRow label="Net Debt" value={formatCurrency(c.netDebt, currency)} danger={c.netDebt > 0} />
        </SectionCard>

        {/* Human Capital Multipliers */}
        <SectionCard title="Human Capital Multipliers">
          <DataRow label="Squad Efficiency Ratio" value={formatRatio(c.squadEfficiency)} highlight />
          <DataRow label="Wage-to-Turnover Ratio" value={formatPercent(c.wageRatio)} danger={c.wageRatio > 1} highlight={c.wageRatio <= 0.7} />
          <DataRow label="Squad Market Value" value={formatCurrency(c.marketValue, currency)} />
          <DataRow label="Annual Wage Bill" value={formatCurrency(c.wages, currency)} />
          <DataRow label="Sourcing Multiplier (MV / Wages)" value={formatRatio(c.marketValue / c.wages)} highlight />
        </SectionCard>
      </div>

      {/* Acquisition Valuation Bridge */}
      <SectionCard title="Acquisition Valuation Bridge">
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="bg-[#1a1a1a] border border-[#2a2a2a] rounded p-4 text-center">
            <p className="font-mono text-[10px] text-[#808080] uppercase tracking-wider mb-2">Enterprise Value</p>
            <p className={`font-mono text-xl font-bold ${m.ev >= 0 ? "text-[#ffffff]" : "text-[#ff4d4d]"}`}>
              {formatCurrency(m.ev, currency, true)}
            </p>
          </div>
          <div className="flex items-center justify-center">
            <div className="text-center">
              <p className="font-mono text-lg text-[#808080]">−</p>
              <p className="font-mono text-[10px] text-[#808080] uppercase">True Adjusted Debt</p>
              <p className="font-mono text-sm font-semibold text-[#ff4d4d]">{formatCurrency(m.trueAdjustedDebt, currency, true)}</p>
            </div>
          </div>
          <div className="bg-[#1a1a1a] border border-[#2a2a2a] rounded p-4 text-center">
            <p className="font-mono text-[10px] text-[#808080] uppercase tracking-wider mb-2">Equity Value</p>
            <p className={`font-mono text-xl font-bold ${m.equityValue >= 0 ? "text-[#ffffff]" : "text-[#ff4d4d]"}`}>
              {formatCurrency(m.equityValue, currency, true)}
            </p>
          </div>
        </div>
      </SectionCard>
    </div>
  );
}

