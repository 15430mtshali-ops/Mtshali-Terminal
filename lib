export function getRatioFigures(club, year) {
  const figs = RATIO_FIGURES[club.id];
  if (!figs) return null;
  const targetYear = year || (club.historical && club.historical.length ? club.historical[0].year : 2025);
  return figs.find((f) => f.year === targetYear) || null;
}

export function computeMetrics(club, currency = "GBP") {
  const c = club.current;
  const hd = club.creditRisk.hardDebt[0] || {};
  const td = club.creditRisk.tradeDebt[0] || {};
  const col = club.creditRisk.collateral[0] || {};
  const rf = getRatioFigures(club);

  // True Adjusted Debt = Bank Debt + Factored Receivables + Transfer Payables + Contingent Liabilities
  const totalHardDebt = (hd.bankLoansShort || 0) + (hd.bankLoansLong || 0) + (hd.factoredShort || 0) + (hd.factoredLong || 0);
  const totalTransferDebt = (td.transferPayablesShort || 0) + (td.transferPayablesLong || 0);
  const contingentLiabilities = (td.contingent || 0);
  const trueAdjustedDebt = totalHardDebt + totalTransferDebt + contingentLiabilities;

  // Enterprise Value = Equity Value (col N) + True Adjusted Debt
  const equityValue = c.enterpriseValue;
  const ev = equityValue + trueAdjustedDebt;

  // EBITDA: real = EBIT + Player Amortisation; proxy = P/L + estimated D&A
  const ebit = rf && rf.ebit !== null && rf.ebit !== undefined ? rf.ebit : null;
  const playerAmortisation = rf && rf.playerAmortisation !== null && rf.playerAmortisation !== undefined ? rf.playerAmortisation : null;
  let ebitda;
  if (ebit !== null && playerAmortisation !== null) {
    ebitda = ebit + playerAmortisation;
  } else {
    ebitda = c.profitLoss + Math.abs(c.wages * 0.15); // PROXY
  }

  // Valuation ratios
  const evRev = c.revenue ? ev / c.revenue : 0;
  const evEbitda = ebitda ? ev / ebitda : 0;
  const netDebtRev = c.revenue ? c.netDebt / c.revenue : 0;

  // LTV = True Adjusted Debt / Squad Market Value
  const ltv = col.rosterValue ? trueAdjustedDebt / col.rosterValue : 0;

  // Acid Test = (Cash + ST Receivables) / (ST Bank Debt + ST Factored + ST Transfer Payables)
  const currentAssets = (col.cash || 0) + (col.transferReceivablesShort || 0);
  const currentLiabilities = (hd.bankLoansShort || 0) + (hd.factoredShort || 0) + (td.transferPayablesShort || 0);
  const acidTest = currentLiabilities ? currentAssets / currentLiabilities : 999;

  // Gross Interest: real when disclosed, else proxy on bank debt
  const grossInterest = rf && rf.grossInterest !== null && rf.grossInterest > 0
    ? rf.grossInterest
    : ((hd.bankLoansShort || 0) + (hd.bankLoansLong || 0)) * 0.065;

  // ICR = EBITDA / Gross Interest
  const icr = grossInterest > 0 ? ebitda / grossInterest : 999;

  // Principal Repayments: real when disclosed, else proxy on bank debt
  const principalRepayments = rf
    ? (rf.principalRepayments || 0)
    : ((hd.bankLoansShort || 0) + (hd.bankLoansLong || 0)) * 0.1;

  // Net Player Trading Cash
  const netPlayerTradingCash = rf ? (rf.netPlayerTradingCash || 0) : 0;

  // DSCR = (EBITDA + Net Player Trading Cash) / (Principal Repayments + Interest)
  const debtService = grossInterest + principalRepayments;
  const dscr = debtService > 0 ? (ebitda + netPlayerTradingCash) / debtService : 999;

  // UEFA Squad Cost = (Wages + Agent Fees + Player Amortisation) / (Revenue + Net Trading Profits)
  const agentFees = rf ? (rf.agentFees || 0) : 0;
  const netTradingProfits = rf ? (rf.netTradingProfits || 0) : 0;
  const uefaDenominator = c.revenue + netTradingProfits;
  const uefaSquadCost = uefaDenominator > 0
    ? (c.wages + agentFees + (playerAmortisation || 0)) / uefaDenominator
    : (c.revenue ? c.wages / c.revenue : 0);

  // Roster Liquidity Buffer
  const liquidityBuffer = ((hd.bankLoansShort || 0) + (td.transferPayablesShort || 0))
    ? ((col.cash || 0) + (col.transferReceivablesShort || 0)) / ((hd.bankLoansShort || 0) + (td.transferPayablesShort || 0))
    : 999;

  // Commercial Debt Exposure
  const commercialDebtExposure = c.revenue ? totalHardDebt / c.revenue : 0;

  // Broadcasting Revenue & % (for stress / sensitivity)
  const broadcastingRevenue = rf && rf.broadcastingRevenue !== null && rf.broadcastingRevenue !== undefined
    ? rf.broadcastingRevenue
    : c.revenue * 0.55;
  const broadcastPct = c.revenue ? broadcastingRevenue / c.revenue : 0.55;

  // Margins
  const ebitdaMargin = c.revenue ? ebitda / c.revenue : 0;
  const operatingMargin = (ebit !== null && c.revenue) ? ebit / c.revenue : 0;
  const netMargin = c.revenue ? c.profitLoss / c.revenue : 0;

  return {
    ev, equityValue, trueAdjustedDebt,
    evRev, evEbitda, netDebtRev, ebitda,
    ebit, playerAmortisation, grossInterest, principalRepayments,
    netPlayerTradingCash, netTradingProfits, agentFees,
    totalHardDebt, totalTransferDebt, contingentLiabilities,
    ltv, acidTest, icr, dscr, uefaSquadCost,
    liquidityBuffer, commercialDebtExposure,
    broadcastingRevenue, broadcastPct,
    ebitdaMargin, operatingMargin, netMargin,
    tradingVelocity: c.marketValue ? c.revenue / c.marketValue : 0,
    hasRealFigures: !!rf,
  };
}

