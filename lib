export const GBP_TO_USD = 1.35;

export function formatCurrency(value, currency = "GBP", compact = false) {
  if (value === null || value === undefined || isNaN(value)) return "—";
  const converted = currency === "USD" ? value * GBP_TO_USD : value;
  const symbol = currency === "USD" ? "$" : "£";
  const abs = Math.abs(converted);
  const sign = converted < 0 ? "-" : "";

  if (compact) {
    if (abs >= 1e9) return `${sign}${symbol}${(abs / 1e9).toFixed(2)}bn`;
    if (abs >= 1e6) return `${sign}${symbol}${(abs / 1e6).toFixed(1)}m`;
    if (abs >= 1e3) return `${sign}${symbol}${(abs / 1e3).toFixed(0)}k`;
    return `${sign}${symbol}${abs.toFixed(0)}`;
  }
  return `${sign}${symbol}${abs.toLocaleString("en-GB", { maximumFractionDigits: 0 })}`;
}

export function formatPercent(value, decimals = 1) {
  if (value === null || value === undefined || isNaN(value)) return "—";
  return `${(value * 100).toFixed(decimals)}%`;
}

export function formatRatio(value, decimals = 2) {
  if (value === null || value === undefined || isNaN(value)) return "—";
  return value.toFixed(decimals);
}

export function getLatestCreditYear(club) {
  if (!club.creditRisk.hardDebt.length) return null;
  return club.creditRisk.hardDebt[0];
}

